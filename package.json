{
  "name": "openspec-matt",
  "version": "0.1.0",
  "description": "Use OpenSpec 2.0's stock workflow with Matt Pocock's skills; archive turns each change into a living spec, GLOSSARY.md and ADRs.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "openspec-matt": "dist/cli.js" },
  "files": ["dist", "assets"],
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
